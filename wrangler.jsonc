{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "malicevic",
  "compatibility_date": "2026-11-07",
  // A single production Worker: new versions get no public preview address.
  "preview_urls": false,
  // The production domain. Cloudflare keeps its DNS record and certificate.
  "routes": [{ "pattern": "enterijermalicevic.ba", "custom_domain": true }],
  // The site lives only on its domain, with no workers.dev copy.
  "workers_dev": false,
  // Static Astro build: Cloudflare serves these files, with no Worker code in front of them.
  "assets": { "directory": "./dist", "not_found_handling": "404-page" }
}
