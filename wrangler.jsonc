{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "malicevic",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the clips reach the Worker, for Safari's range requests. Everything else is a
    // plain static asset, free and outside the account's daily request quota.
    "run_worker_first": ["/video/*"]
  }
}
