---
import "../styles/global.css";
import interLatin from "../assets/fonts/inter-tight-latin-wght-normal.woff2?url";
import newsreaderLatin from "../assets/fonts/newsreader-latin-wght-normal.woff2?url";
import { site } from "../data/site";
import { getUI, type Lang } from "../i18n/ui";
import { homePaths, jsonLd, langs, ogImage, type PageMeta, type Paths } from "../lib/seo";

interface Props {
  lang: Lang;
  /** This page in every language. Defaults to the home page, as do the fields below. */
  paths?: Paths;
  title?: string;
  description?: string;
  /** Photo name for og:image, cropped to 1200x630. */
  image?: string;
  /** Page-specific JSON-LD: page type, breadcrumbs, extra nodes. */
  ld?: Pick<PageMeta, "type" | "crumbs" | "about" | "nodes">;
}
const { lang, paths = homePaths, image, ld: pageLd } = Astro.props;
const t = getUI(lang);
const title = Astro.props.title ?? t.metaTitle;
const description = Astro.props.description ?? t.metaDescription;
const origin = Astro.site!;
const href = (l: Lang) => new URL(paths[l], origin).href;
const canonical = href(lang);
const og = await ogImage(image);
const ogUrl = new URL(og.src, origin).href;
const ld = await jsonLd({ lang, paths, title, description, image: ogUrl, ...pageLd }, origin);
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f3f0" />
    <link rel="canonical" href={canonical} />
    {
      langs.map((l) => <link rel="alternate" hreflang={getUI(l).hreflang} href={href(l)} />)
    }
    <link rel="alternate" hreflang="x-default" href={href("sr")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={t.ogLocale} />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={getUI(l).ogLocale} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={newsreaderLatin} as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-black focus:px-4 focus:py-2 focus:text-white"
      >{t.skip}</a
    >
    <slot />
    <script>
      import "../scripts/main.ts";
    </script>
  </body>
</html>
