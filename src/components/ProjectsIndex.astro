---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Contact from "./Contact.astro";
import { projectPath, projects } from "../data/projects";
import { photo } from "../data/photos";
import { site } from "../data/site";
import { getUI, otherLang, projectsPath, type Lang } from "../i18n/ui";
import { projectsPaths } from "../lib/seo";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getUI(lang);
const origin = Astro.site!;
const pad = (n: number) => String(n).padStart(2, "0");
const total = pad(projects.length);
// Grid view is two columns from tablet width; with an odd count the first tile spans
// both, so the last row is never half empty.
const odd = projects.length % 2 === 1;
// The List/Grid switch is built but hidden for now: only the list is offered. Set this to
// true to bring the switch (and so the grid) back. The radios stay in the page either way,
// because the list stays visible only while #v-list is checked.
const pickView = false;

const ld = {
  type: "CollectionPage" as const,
  crumbs: [[t.projects.title, projectsPath(lang)]] as [string, string][],
  nodes: [
    {
      "@type": "ItemList",
      "@id": `${new URL(projectsPath(lang), origin).href}#projects`,
      itemListElement: projects.map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: p.title[lang],
        url: new URL(projectPath(p, lang), origin).href,
      })),
    },
  ],
};
---

<Layout
  lang={lang}
  paths={projectsPaths}
  title={`${t.projects.title} | ${site.name}`}
  description={t.projects.metaDescription}
  image={projects[0]!.photos[0]}
  ld={ld}
>
  <Header lang={lang} alt={projectsPath(otherLang(lang))} solid />
  <main id="main">
    <section class="wrap grid gap-8 pb-14 pt-32 md:grid-cols-12 md:items-end md:pb-24 md:pt-48" style="--intro: 0.15s">
      <div class="md:col-span-8">
        <p class="hero-rise eyebrow mb-6" style="--d:0">
          {t.projects.eyebrow} <span class="text-mute">· {total}</span>
        </p>
        <h1 class="h-display max-w-[14ch]">
          <span class="line"><span class="line-in" style="--d:0">{t.projects.line1}</span></span>
          <span class="line"><span class="line-in font-serif font-normal italic" style="--d:1">{t.projects.line2}</span></span>
        </h1>
      </div>
      <p class="hero-rise max-w-sm text-mute md:col-span-4 md:justify-self-end" style="--d:3">{t.projects.intro}</p>
    </section>

    <div class="pj">
      <!-- List: one row per project, everything visible at once. The title, note and
           facts on the left, three of its photos on the right; the whole row is the link. -->
      <ol class="pj-list wrap">
        {
          projects.map((p, i) => (
            <li class="pj-item">
              <a href={projectPath(p, lang)} class="hover-zoom group grid grid-cols-1 gap-7 py-10 md:grid-cols-12 md:gap-10 md:py-16">
                <div class="flex flex-col md:col-span-4">
                  <p class="font-serif text-lg italic text-mute tabular-nums">
                    {pad(i + 1)} <span class="text-sm">/ {total}</span>
                  </p>
                  <h2 class="mt-3 text-balance font-serif text-3xl leading-[1.05] tracking-tight md:mt-5 md:text-5xl">
                    {p.title[lang]}
                  </h2>
                  <p class="mt-4 max-w-sm text-mute">{p.note[lang]}</p>
                  <p class="eyebrow mt-6 text-mute md:mb-8">
                    {t.categories[p.category]} · {p.year}
                  </p>
                  <span class="pill mt-8 self-start transition-colors group-hover:bg-ink group-hover:text-white md:mt-auto">
                    {t.projects.view} →
                  </span>
                </div>
                <div class="pj-strip md:col-span-8">
                  {p.photos.slice(0, 3).map((name, j) => (
                    <span
                      class:list={["pj-frame unveil", { "pj-frame--cover": j === 0 }]}
                      data-vt={j === 0 ? p.id : undefined}
                      data-vt-href={j === 0 ? projectPath(p, lang) : undefined}
                    >
                      <Image
                        src={photo(name)}
                        alt={j === 0 ? p.title[lang] : ""}
                        widths={j === 0 ? [640, 960, 1280] : [400, 640, 800]}
                        sizes={j === 0 ? "(min-width: 768px) 45vw, 100vw" : "(min-width: 768px) 22vw, 50vw"}
                        loading={i === 0 ? "eager" : "lazy"}
                        class="unveil-img h-full w-full object-cover"
                      />
                    </span>
                  ))}
                </div>
              </a>
            </li>
          ))
        }
      </ol>

      <!-- The toggle hides this wrapper, not the list: a display utility such as `grid`
           sits in a later layer and would win over the component rule. -->
      <div class="pj-grid">
      <ul class="wrap grid gap-x-5 gap-y-12 md:grid-cols-2 md:gap-y-16">
        {
          projects.map((p, i) => {
            const big = odd && i === 0;
            return (
              <li class:list={{ "md:col-span-2": big }}>
                <a href={projectPath(p, lang)} class="hover-zoom group block">
                  <span class:list={["unveil block aspect-[4/3] overflow-clip rounded-card", { "md:aspect-[21/9]": big }]}>
                    <Image
                      src={photo(p.photos[0]!)}
                      alt={p.title[lang]}
                      widths={big ? [800, 1280, 1920] : [480, 800, 1100]}
                      sizes={big ? "100vw" : "(min-width: 768px) 50vw, 100vw"}
                      loading="lazy"
                      class="unveil-img h-full w-full object-cover"
                    />
                  </span>
                  <span class="mt-5 flex items-baseline justify-between gap-6 px-1">
                    <span class="font-serif text-2xl leading-tight tracking-tight md:text-4xl">{p.title[lang]}</span>
                    <span class="shrink-0 font-serif italic text-mute tabular-nums">{pad(i + 1)}</span>
                  </span>
                  <span class="mt-2 block px-1 text-sm text-mute">
                    {t.categories[p.category]} · {p.year}
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
      </div>

      <!-- Floating switch: sticky to the bottom of the screen for as long as the list or
           grid is in view. Radios, so the switch works without JavaScript. -->
      <div class:list={["pj-switch", { hidden: !pickView }]}>
        <div class="pj-switch-in" role="radiogroup" aria-label={t.projects.viewLabel}>
          <input type="radio" name="pv" id="v-list" class="pf-radio" checked />
          <label for="v-list" class="pj-opt">
            <svg class="pj-opt-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3.5h12M2 8h12M2 12.5h12" /></svg>
            {t.projects.views.list}
          </label>
          <input type="radio" name="pv" id="v-grid" class="pf-radio" />
          <label for="v-grid" class="pj-opt">
            <svg class="pj-opt-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 2.5h4v4h-4zM9.5 2.5h4v4h-4zM2.5 9.5h4v4h-4zM9.5 9.5h4v4h-4z" /></svg>
            {t.projects.views.grid}
          </label>
        </div>
      </div>
    </div>
  </main>
  <Contact lang={lang} />
</Layout>
