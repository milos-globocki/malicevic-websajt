---
import { site } from "../data/site";
import { getUI, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getUI(lang).contact;

// The logo sits at the foot of the left column, its base on the list's last rule.
// On phones the column stacks, so it moves below the list instead.
const mask = "mask:url(/brand/lockup.png) left bottom/contain no-repeat;-webkit-mask:url(/brand/lockup.png) left bottom/contain no-repeat";
const lockupLabel = `${site.shortName} Wood Form`;

// Plain rows are whole-row links. The Viber and WhatsApp row is separate: one number,
// two apps, so it carries a button for each instead of repeating the number.
const rows = [
  { label: t.call, value: site.phone.display, href: `tel:${site.phone.href}` },
  ...(site.phoneIntl.href ? [{ label: t.intl, value: site.phoneIntl.display, href: `tel:${site.phoneIntl.href}` }] : []),
];
const social = [
  { label: "Instagram", value: "@enterijer_malicevic", href: site.instagram },
  { label: "Facebook", value: "Maličević Enterijeri", href: site.facebook },
  { label: "TikTok", value: "@enterijermalicevic", href: site.tiktok },
  { label: t.email, value: site.email, href: `mailto:${site.email}` },
];
const apps = [
  { label: t.viber, href: `viber://chat?number=%2B${site.messenger.digits}` },
  { label: t.whatsapp, href: `https://wa.me/${site.messenger.digits}` },
];
---

<section id="contact" class="rounded-t-[2rem] bg-black text-white md:rounded-t-[3rem]">
  <div class="wrap py-20 md:py-32">
    <div class="grid gap-14 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-5 md:flex md:flex-col">
        <p class="eyebrow mb-5 text-white/60">{t.eyebrow}</p>
        <h2 class="h-section max-w-[14ch]">{t.title}</h2>
        <p class="mt-6 max-w-sm text-white/70">{t.text}</p>

        <div class="mt-12 space-y-8 text-white/85">
          <div>
            <p class="eyebrow mb-2 text-white/50">{t.hours}</p>
            <p>{site.hours[lang]}</p>
          </div>
        </div>

        <div class="mt-auto hidden pt-12 md:block">
          <span role="img" aria-label={lockupLabel} class="block aspect-[890/759] w-28 bg-white" style={mask}></span>
        </div>
      </div>

      <ul class="md:col-span-7 md:col-start-6">
        {rows.map((r) => (
            <li>
              <a
                class="contact-link"
                href={r.href}
                target={r.href.startsWith("http") ? "_blank" : undefined}
                rel={r.href.startsWith("http") ? "noopener" : undefined}
              >
                <span class="eyebrow shrink-0 text-white/55">{r.label}</span>
                <span class="min-w-0 text-right font-serif text-xl tracking-tight [overflow-wrap:anywhere] min-[400px]:text-2xl md:text-2xl lg:text-4xl">{r.value}&nbsp;<span aria-hidden="true">↗</span></span>
              </a>
            </li>
          ))}
        <li class="contact-row">
          <span class="eyebrow text-white/55">{t.messenger}</span>
          <span class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4">
            <span class="font-serif text-xl tracking-tight min-[400px]:text-2xl md:text-2xl lg:text-4xl">{site.messenger.display}</span>
            <span class="flex gap-2">
              {apps.map((app) => (
                <a class="pill pill--light" href={app.href} target={app.href.startsWith("http") ? "_blank" : undefined} rel={app.href.startsWith("http") ? "noopener" : undefined}>{app.label} <span aria-hidden="true">↗</span></a>
              ))}
            </span>
          </span>
        </li>
        {social.map((r) => (
            <li>
              <a
                class="contact-link"
                href={r.href}
                target={r.href.startsWith("http") ? "_blank" : undefined}
                rel={r.href.startsWith("http") ? "noopener" : undefined}
              >
                <span class="eyebrow shrink-0 text-white/55">{r.label}</span>
                <span class="min-w-0 text-right font-serif text-xl tracking-tight [overflow-wrap:anywhere] min-[400px]:text-2xl md:text-2xl lg:text-4xl">{r.value}&nbsp;<span aria-hidden="true">↗</span></span>
              </a>
            </li>
          ))}
        <li class="border-t border-white/20"></li>
      </ul>

      <span role="img" aria-label={lockupLabel} class="block aspect-[890/759] w-24 bg-white md:hidden" style={mask}></span>
    </div>
  </div>

  <footer class="border-t border-white/15">
    <div class="wrap flex flex-col gap-2 py-6 text-sm text-white/55 md:flex-row md:items-center md:justify-between">
      <p>© {new Date().getFullYear()} {site.name}. {getUI(lang).footer.rights}</p>
      <p>{site.tagline[lang]}</p>
      <p class="flex items-center gap-2">
        {getUI(lang).footer.credit} {site.developer.name}
        <a
          href={site.developer.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${getUI(lang).footer.linkedin}: ${site.developer.name}`}
          class="inline-flex text-white/55 transition-colors hover:text-white"
        >
          <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" class="block">
            <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.708-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.079-.586.173-.431.568-.878 1.232-.878.868 0 1.216.662 1.216 1.632v6.62h2.401V9.197c0-2.217-1.184-3.252-2.762-3.252-1.285 0-1.858.707-2.172 1.2h.032V6.169h-2.4c.03.679 0 7.225 0 7.225z" />
          </svg>
        </a>
      </p>
    </div>
  </footer>
</section>
