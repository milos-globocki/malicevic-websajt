---
import { site } from "../data/site";
import { getUI, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getUI(lang).contact;

const rows = [
  { label: t.call, value: site.phone.display, href: `tel:${site.phone.href}` },
  ...(site.viber ? [{ label: t.viber, value: site.phone.display, href: `viber://chat?number=%2B${site.viber}` }] : []),
  { label: t.whatsapp, value: site.phone.display, href: `https://wa.me/${site.whatsapp}` },
  { label: "Instagram", value: "@enterijer_malicevic", href: site.instagram },
  { label: "Facebook", value: "Maličević Enterijeri", href: site.facebook },
  { label: t.email, value: site.email, href: `mailto:${site.email}` },
];
---

<section id="contact" class="rounded-t-[2rem] bg-black text-white md:rounded-t-[3rem]">
  <div class="wrap py-20 md:py-32">
    <div class="grid gap-14 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-5">
        <p class="eyebrow mb-5 text-white/60">{t.eyebrow}</p>
        <h2 class="h-section max-w-[14ch]">{t.title}</h2>
        <p class="mt-6 max-w-sm text-white/70">{t.text}</p>

        <div class="mt-12 space-y-8 text-white/85">
          <div>
            <p class="eyebrow mb-2 text-white/50">{t.visit}</p>
            <address class="not-italic leading-relaxed">
              {site.address.street}<br />
              {site.address.city}, {site.address.country[lang]}
            </address>
            <a href={site.mapUrl} class="mt-3 inline-block underline underline-offset-4" target="_blank" rel="noopener">{t.map} ↗</a>
          </div>
          <div>
            <p class="eyebrow mb-2 text-white/50">{t.hours}</p>
            <p>{site.hours[lang]}</p>
          </div>
        </div>
      </div>

      <ul class="md:col-span-7 md:col-start-6">
        {
          rows.map((r) => (
            <li>
              <a
                class="contact-link"
                href={r.href}
                target={r.href.startsWith("http") ? "_blank" : undefined}
                rel={r.href.startsWith("http") ? "noopener" : undefined}
              >
                <span class="eyebrow text-white/55">{r.label}</span>
                <span class="font-serif text-2xl tracking-tight md:text-4xl">{r.value} <span aria-hidden="true">↗</span></span>
              </a>
            </li>
          ))
        }
        <li class="border-t border-white/20"></li>
      </ul>
    </div>
  </div>

  <footer class="border-t border-white/15">
    <div class="wrap flex flex-col gap-2 py-6 text-sm text-white/55 md:flex-row md:justify-between">
      <p>© {new Date().getFullYear()} {site.name}. {getUI(lang).footer.rights}</p>
      <p>{site.tagline[lang]}</p>
    </div>
  </footer>
</section>
