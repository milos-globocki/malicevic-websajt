---
import { Image } from "astro:assets";
import { photo } from "../data/photos";
import { getUI, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const t = getUI(Astro.props.lang).offer;
---

<section id="services" class="wrap pb-24 md:pb-40">
  <div class="mb-12 grid gap-6 md:mb-16 md:grid-cols-12">
    <p class="eyebrow reveal md:col-span-3">{t.eyebrow}</p>
    <h2 class="h-section reveal md:col-span-9 md:max-w-[22ch]">{t.title}</h2>
  </div>
  <ul class="grid gap-4 md:grid-cols-3">
    {
      t.items.map((item, i) => (
        <li class="reveal hover-zoom flex flex-col rounded-card bg-white p-2.5" style={`--i:${i}`}>
          <div class="relative aspect-[4/3] overflow-clip rounded-[15px]">
            <Image
              src={photo(`offer-${i + 1}`)}
              alt=""
              widths={[480, 800, 1100]}
              sizes="(min-width: 768px) 33vw, 100vw"
              loading="lazy"
              class="absolute inset-0 h-full w-full object-cover"
            />
          </div>
          <div class="flex flex-1 flex-col px-4 pt-6 pb-5 md:px-6 md:pt-8 md:pb-7">
            <span class="font-serif text-lg italic text-mute">0{i + 1}</span>
            <h3 class="mt-3 font-serif text-3xl leading-tight tracking-tight md:text-4xl">{item.title}</h3>
            <p class="mt-4 text-base leading-relaxed text-mute">{item.text}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>
