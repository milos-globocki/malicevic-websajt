---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Contact from "./Contact.astro";
import Lightbox from "./Lightbox.astro";
import { nextProject, projectPath, type Project } from "../data/projects";
import { photo } from "../data/photos";
import { site } from "../data/site";
import { getUI, otherLang, projectsPath, type Lang } from "../i18n/ui";
import { projectImage, projectPaths } from "../lib/seo";
import { splitWords } from "../lib/words";

interface Props {
  lang: Lang;
  project: Project;
}
const { lang, project: p } = Astro.props;
const t = getUI(lang);
const origin = Astro.site!;
const paths = projectPaths(p);
const url = new URL(paths[lang], origin).href;
const next = nextProject(p);
const title = p.title[lang];
const category = t.portfolio.filters[p.category];
const [cover, ...rest] = p.photos as [string, ...string[]];
const alt = (i: number) => `${title}, ${i + 1}/${p.photos.length}`;

// Shapes come from the lightbox-size getImage() result: touching photo().width would
// make Astro ship the original JPEG too. A landscape photo gets a row of its own, two
// portrait or square photos share one, and a leftover one sits centred at half width.
const shots = await Promise.all(
  rest.map(async (name, i) => {
    const full = await projectImage(name);
    const { width, height } = full.options.src as ImageMetadata;
    return { name, full: full.src, ratio: width / height, alt: alt(i + 1) };
  }),
);
const wide = (s: (typeof shots)[number]) => s.ratio >= 1.2;
const rows: (typeof shots)[] = [];
for (let i = 0; i < shots.length; i++) {
  const s = shots[i]!;
  const n = shots[i + 1];
  if (!wide(s) && n && !wide(n)) {
    rows.push([s, n]);
    i++;
  } else rows.push([s]);
}

// Meta description: the one-line note, plus the intro's first sentence while it fits.
const lead = p.intro[lang].split(/(?<=\.)\s/)[0]!;
const description = `${p.note[lang]} ${lead}`.length <= 170 ? `${p.note[lang]} ${lead}` : p.note[lang];
const images = await Promise.all(p.photos.map(async (n) => new URL((await projectImage(n)).src, origin).href));
const ld = {
  crumbs: [
    [t.projects.title, projectsPath(lang)],
    [title, paths[lang]],
  ] as [string, string][],
  about: `${url}#project`,
  nodes: [
    {
      "@type": "CreativeWork",
      "@id": `${url}#project`,
      name: title,
      description: p.intro[lang],
      url,
      image: images,
      dateCreated: String(p.year),
      genre: category,
      inLanguage: t.htmlLang,
      creator: { "@id": `${origin.href}#business` },
    },
  ],
};
const words = splitWords(p.intro[lang]);
---

<Layout lang={lang} paths={paths} title={`${title} | ${site.name}`} description={description} image={cover} ld={ld}>
  <Header lang={lang} alt={paths[otherLang(lang)]} />
  <main id="main">
    <!--
      Same opening as the home hero (the photo opens from a card to full bleed, the title
      rises), but the photo fades into the paper at the bottom and the title sits on it.
    -->
    <section class="relative isolate flex h-[100svh] min-h-[34rem] items-end overflow-hidden">
      <div class="hero-media absolute inset-0 -z-10">
        <div class="hero-frame absolute inset-0 overflow-hidden bg-[#1a1612]">
          <Image
            src={photo(cover)}
            alt={alt(0)}
            widths={[800, 1280, 1920, 2400]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
            class="hero-img h-full w-full object-cover"
          />
          <div class="pj-hero-shade absolute inset-0"></div>
        </div>
      </div>

      <div class="hero-copy wrap pb-8 md:pb-12">
        <nav class="hero-rise eyebrow mb-5 flex flex-wrap gap-x-2 text-mute" style="--d:0" aria-label={t.projects.title}>
          <a href={projectsPath(lang)} class="text-ink underline-offset-4 hover:underline">{t.projects.title}</a>
          <span aria-hidden="true">/</span>
          <span>{category}</span>
        </nav>
        <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between md:gap-10">
          <h1 class="h-display max-w-[18ch]" style="font-size: clamp(2.25rem, 5.4vw, 5.25rem)">
            <span class="line"><span class="line-in text-balance" style="--d:0">{title}</span></span>
          </h1>
          <p class="hero-rise max-w-sm text-mute md:text-right" style="--d:2">{p.note[lang]}</p>
        </div>
      </div>
    </section>

    <section class="wrap py-20 md:py-32">
      <div class="grid gap-12 md:grid-cols-12 md:gap-10">
        <dl class="reveal grid grid-cols-3 gap-6 self-start md:col-span-3 md:grid-cols-1 md:gap-8">
          <div>
            <dt class="eyebrow mb-2 text-mute">{t.projects.service}</dt>
            <dd>{category}</dd>
          </div>
          <div>
            <dt class="eyebrow mb-2 text-mute">{t.projects.year}</dt>
            <dd>{p.year}</dd>
          </div>
          <div>
            <dt class="eyebrow mb-2 text-mute">{t.projects.photos}</dt>
            <dd class="tabular-nums">{p.photos.length}</dd>
          </div>
        </dl>
        <p class="fill pj-intro md:col-span-9">
          {words.map(({ word, p: at }) => <span class="w" style={`--p:${at}`}>{word} </span>)}
        </p>
      </div>
    </section>

    <section class="wrap pb-24 md:pb-40" aria-label={t.projects.photos}>
      <div class="pj-rows">
        {
          rows.map((row) => (
            <div class:list={["pj-row", { "pj-row--lone": row.length === 1 && !wide(row[0]!) }]}>
              {row.map((s) => (
                <button
                  type="button"
                  class="pj-shot unveil"
                  style={`--r:${s.ratio.toFixed(4)}`}
                  data-lb
                  data-full={s.full}
                  data-alt={s.alt}
                  data-title={title}
                  data-note={p.note[lang]}
                  aria-label={`${t.portfolio.open}: ${s.alt}`}
                >
                  <Image
                    src={photo(s.name)}
                    alt={s.alt}
                    widths={row.length === 1 && wide(s) ? [800, 1280, 1920] : [480, 800, 1100]}
                    sizes={row.length === 1 && wide(s) ? "100vw" : "(min-width: 640px) 50vw, 100vw"}
                    loading="lazy"
                    class="par pj-shot-img"
                  />
                </button>
              ))}
            </div>
          ))
        }
      </div>
    </section>

    <section class="px-5 pb-24 md:px-10 md:pb-40">
      <a href={projectPath(next, lang)} class="vband group block h-[min(72svh,46rem)]">
        <Image src={photo(next.photos[0]!)} alt="" widths={[800, 1280, 1920]} sizes="100vw" loading="lazy" class="vband-media" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/15 to-black/25"></div>
        <div class="absolute inset-x-0 bottom-0 flex flex-col gap-7 p-7 text-white md:flex-row md:items-end md:justify-between md:p-14">
          <div>
            <p class="eyebrow mb-4 text-white/80">{t.projects.next}</p>
            <h2 class="h-section max-w-[18ch] text-balance">{next.title[lang]}</h2>
          </div>
          <span class="pill pill--light shrink-0 self-start md:self-auto">{t.projects.view} →</span>
        </div>
      </a>
    </section>
  </main>
  <Contact lang={lang} />
  <Lightbox lang={lang} label={title} />
</Layout>
