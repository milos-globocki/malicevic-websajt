---
import { getUI, homePath, otherLang, languages, projectsPath, type Lang } from "../i18n/ui";
import { site } from "../data/site";
import Mark from "./Mark.astro";

interface Props {
  lang: Lang;
  /** The same page in the other language. Defaults to its home page. */
  alt?: string;
  /** For pages that open on paper rather than a photo: dark from the start, no intro fade. */
  solid?: boolean;
}
const { lang, solid = false } = Astro.props;
const t = getUI(lang);
const other = otherLang(lang);
const alt = Astro.props.alt ?? homePath(other);
// Home page sections are plain anchors at home and full links elsewhere. Every page
// ends with the contact section, so that one is always local.
const home = homePath(lang);
const onHome = Astro.url.pathname === home;
const section = (id: string) => (onHome ? `#${id}` : `${home}#${id}`);
const links = [
  { href: onHome ? "#top" : home, label: t.nav.home },
  { href: section("services"), label: t.nav.services },
  { href: projectsPath(lang), label: t.nav.projects },
  { href: section("about"), label: t.nav.about },
  { href: "#contact", label: t.nav.contact },
];
---

<header class:list={["site-header", { "site-header--solid": solid }]}>
  <div class:list={["wrap flex h-16 items-center justify-between md:h-20", { "intro-fade": !solid }]}>
    <a href={home} class="flex items-center gap-2.5 text-lg font-semibold tracking-tight md:text-xl" aria-label={site.name}>
      <Mark class="h-[1.15em] w-auto shrink-0" />
      <span>MALIČEVIĆ<span class="ml-1.5 font-normal opacity-70 max-[359px]:hidden">Enterijeri</span></span>
    </a>

    <nav class="hidden items-center gap-8 text-sm font-medium lg:flex" aria-label="Main">
      {links.map((l) => <a href={l.href} class="opacity-80 transition-opacity hover:opacity-100">{l.label}</a>)}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={alt}
        hreflang={getUI(other).hreflang}
        lang={getUI(other).htmlLang}
        class="text-sm font-medium uppercase opacity-80 hover:opacity-100"
        aria-label={languages[other]}>{other}</a
      >
      <a href="#contact" class="pill hidden lg:inline-flex">{t.cta}</a>
      <button popovertarget="menu" class="pill lg:hidden" aria-label={t.menu}>{t.menu}</button>
    </div>
  </div>
</header>

<nav id="menu" popover class="menu-pop" aria-label="Menu">
  <div class="flex items-center justify-between">
    <span class="flex items-center gap-2.5 text-lg font-semibold tracking-tight">
      <Mark class="h-[1.15em] w-auto shrink-0" />MALIČEVIĆ
    </span>
    <button popovertarget="menu" popovertargetaction="hide" class="pill">{t.close}</button>
  </div>
  <ul class="mt-12 space-y-2">
    {
      links.map((l) => (
        <li>
          <a href={l.href} class="block py-2 font-serif text-5xl tracking-tight">{l.label}</a>
        </li>
      ))
    }
  </ul>
  <a href="#contact" class="pill pill--solid mt-10">{t.cta}</a>
</nav>
