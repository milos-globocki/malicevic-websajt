---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { projects } from "../data/projects";
import { photo } from "../data/photos";
import { getUI, type Lang } from "../i18n/ui";
import { projectImage } from "../lib/seo";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getUI(lang).portfolio;
const filters = ["all", "finished", "designer", "custom"] as const;

// Tile shape comes from the photo itself, read off the getImage() result: touching
// photo().width directly would make Astro ship the original JPEG too. Portrait shots
// span two rows; the first project, if landscape, is a large 2x2 tile on desktop.
const items = (
  await Promise.all(
    projects.map(async (p) => {
      const full = await projectImage(p.image);
      const { width, height } = full.options.src as ImageMetadata;
      return { ...p, full: full.src, tall: height > width };
    }),
  )
).map((p, i) => ({ ...p, big: i === 0 && !p.tall }));
---

<section id="portfolio" class="pf wrap pb-24 md:pb-40">
  <div class="mb-10 grid gap-6 md:mb-14 md:grid-cols-12 md:items-end">
    <div class="md:col-span-7">
      <p class="eyebrow reveal mb-4">{t.eyebrow}</p>
      <h2 class="h-section reveal">{t.title}</h2>
    </div>
    <div class="reveal flex flex-wrap gap-2 md:col-span-5 md:justify-end" role="radiogroup" aria-label={t.title}>
      {
        filters.map((f, i) => (
          <>
            <input type="radio" name="pf" id={`f-${f}`} class="pf-radio" checked={i === 0} />
            <label for={`f-${f}`} class="pf-pill">{t.filters[f]}</label>
          </>
        ))
      }
    </div>
  </div>

  <!-- Packed grid: row height follows column width (container units), portrait
       tiles span two rows, and dense flow fills the holes a filter leaves. -->
  <div class="pf-wrap">
  <ul class="pf-grid">
    {
      items.map((p) => (
        <li class:list={["pf-item", { "pf-tall": p.tall, "pf-big": p.big }]} data-cat={p.category}>
          <button
            type="button"
            class="hover-zoom group flex h-full w-full flex-col text-left"
            data-lb
            data-full={p.full}
            data-alt={p.title[lang]}
            data-caption={`${p.title[lang]} — ${p.note[lang]}`}
            aria-label={`${t.open}: ${p.title[lang]}`}
          >
            <span class="unveil block min-h-0 flex-1 overflow-clip rounded-card">
              <Image
                src={photo(p.image)}
                alt={p.title[lang]}
                widths={p.big ? [800, 1100, 1600] : [480, 800, 1100]}
                sizes={p.big ? "(min-width: 768px) 66vw, 50vw" : "(min-width: 768px) 33vw, 50vw"}
                loading="lazy"
                class="unveil-img h-full w-full object-cover"
              />
            </span>
            <span class="flex h-12 shrink-0 items-center justify-between gap-3 px-1">
              <span class="min-w-0 truncate font-serif text-base leading-tight tracking-tight md:text-2xl">{p.title[lang]}</span>
              <span class="shrink-0 text-xs text-mute">{p.year}</span>
            </span>
          </button>
        </li>
      ))
    }
  </ul>
  </div>

  <dialog id="lb" class="lb" aria-label={t.title}>
    <img alt="" />
    <div class="mt-4 flex items-center justify-between gap-4">
      <p data-lb-caption class="text-sm text-white/80"></p>
      <div class="flex shrink-0 gap-2">
        <button type="button" class="lb-btn" data-lb-prev aria-label={t.prev}>←</button>
        <button type="button" class="lb-btn" data-lb-next aria-label={t.next}>→</button>
        <button type="button" class="lb-btn" data-lb-close aria-label={getUI(lang).close}>✕</button>
      </div>
    </div>
  </dialog>
</section>
