---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Lightbox from "./Lightbox.astro";
import { works } from "../data/projects";
import { photo } from "../data/photos";
import { getUI, type Lang } from "../i18n/ui";
import { projectImage } from "../lib/seo";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getUI(lang).portfolio;

// Tile shape comes from the photo itself, read off the getImage() result: touching
// photo().width directly would make Astro ship the original JPEG too. Portrait shots
// span two rows; the first work, if landscape, is a large 2x2 tile on desktop.
const items = (
  await Promise.all(
    works.map(async (w) => {
      const full = await projectImage(w.image);
      const { width, height } = full.options.src as ImageMetadata;
      return { ...w, full: full.src, tall: height > width };
    }),
  )
).map((w, i) => ({ ...w, big: i === 0 && !w.tall }));

// "Selected" shows the whole wall; a category is only offered when a work belongs to it.
const filters = (["selected", "designer", "custom"] as const).filter(
  (f) => f === "selected" || items.some((w) => w.category === f),
);
---

<section id="portfolio" class="pf wrap pb-24 md:pb-40">
  <div class="mb-10 grid gap-6 md:mb-14 md:grid-cols-12 md:items-end">
    <div class="md:col-span-7">
      <p class="eyebrow reveal mb-4">{t.eyebrow}</p>
      <h2 class="h-section reveal">{t.title}</h2>
    </div>
    <div class="reveal flex flex-wrap gap-2 md:col-span-5 md:justify-end" role="radiogroup" aria-label={t.title}>
      {
        filters.map((f, i) => (
          <>
            <input type="radio" name="pf" id={`f-${f}`} class="pf-radio" checked={i === 0} />
            <label for={`f-${f}`} class="pf-pill">{t.filters[f]}</label>
          </>
        ))
      }
    </div>
  </div>

  <!-- Packed grid: row height follows column width (container units), portrait
       tiles span two rows, and dense flow fills the holes a filter leaves.
       Each tile opens its photo in the lightbox. -->
  <div class="pf-wrap">
  <ul class="pf-grid">
    {
      items.map((w) => (
        <li class:list={["pf-item", { "pf-tall": w.tall, "pf-big": w.big }]} data-cat={w.category}>
          <button
            type="button"
            class="hover-zoom group flex h-full w-full flex-col text-left"
            data-lb
            data-full={w.full}
            data-alt={w.title[lang]}
            data-title={w.title[lang]}
            data-note={t.filters[w.category]}
            aria-label={`${t.open}: ${w.title[lang]}`}
          >
            <span class="unveil block min-h-0 flex-1 overflow-clip rounded-card">
              <Image
                src={photo(w.image)}
                alt={w.title[lang]}
                widths={w.big ? [800, 1100, 1600] : [480, 800, 1100]}
                sizes={w.big ? "(min-width: 768px) 66vw, 50vw" : "(min-width: 768px) 33vw, 50vw"}
                loading="lazy"
                class="unveil-img h-full w-full object-cover"
              />
            </span>
            <span class="flex h-12 shrink-0 items-center justify-between gap-3 px-1">
              <span class="min-w-0 truncate font-serif text-base leading-tight tracking-tight md:text-2xl">{w.title[lang]}</span>
              <span class="hidden shrink-0 text-xs text-mute md:inline">{t.filters[w.category]}</span>
            </span>
          </button>
        </li>
      ))
    }
  </ul>
  </div>

  <Lightbox lang={lang} label={t.title} />
</section>
