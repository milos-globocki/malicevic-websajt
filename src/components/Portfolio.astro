---
import { Image } from "astro:assets";
import { projects } from "../data/projects";
import { photo } from "../data/photos";
import { getUI, type Lang } from "../i18n/ui";
import { projectImage } from "../lib/seo";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getUI(lang).portfolio;
const filters = ["all", "finished", "designer", "custom"] as const;

const items = await Promise.all(
  projects.map(async (p) => ({
    ...p,
    full: (await projectImage(p.image)).src,
  })),
);
---

<section id="portfolio" class="pf wrap pb-24 md:pb-40">
  <div class="mb-10 grid gap-6 md:mb-14 md:grid-cols-12 md:items-end">
    <div class="md:col-span-7">
      <p class="eyebrow reveal mb-4">{t.eyebrow}</p>
      <h2 class="h-section reveal">{t.title}</h2>
    </div>
    <div class="reveal flex flex-wrap gap-2 md:col-span-5 md:justify-end" role="radiogroup" aria-label={t.title}>
      {
        filters.map((f, i) => (
          <>
            <input type="radio" name="pf" id={`f-${f}`} class="pf-radio" checked={i === 0} />
            <label for={`f-${f}`} class="pf-pill">{t.filters[f]}</label>
          </>
        ))
      }
    </div>
  </div>

  <ul class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-5">
    {
      items.map((p) => (
        <li class="pf-item" data-cat={p.category}>
          <button
            type="button"
            class="hover-zoom group block w-full overflow-hidden rounded-card text-left"
            data-lb
            data-full={p.full}
            data-alt={p.title[lang]}
            data-caption={`${p.title[lang]} — ${p.note[lang]}`}
            aria-label={`${t.open}: ${p.title[lang]}`}
          >
            <Image
              src={photo(p.image)}
              alt={p.title[lang]}
              widths={[480, 800, 1100]}
              sizes="(min-width: 768px) 33vw, 50vw"
              loading="lazy"
              class="aspect-[4/5] w-full object-cover"
            />
            <span class="mt-3 flex items-baseline justify-between gap-3 px-1">
              <span class="font-serif text-xl leading-tight tracking-tight md:text-2xl">{p.title[lang]}</span>
              <span class="shrink-0 text-xs text-mute">{p.year}</span>
            </span>
          </button>
        </li>
      ))
    }
  </ul>

  <dialog id="lb" class="lb" aria-label={t.title}>
    <img alt="" />
    <div class="mt-4 flex items-center justify-between gap-4">
      <p data-lb-caption class="text-sm text-white/80"></p>
      <div class="flex shrink-0 gap-2">
        <button type="button" class="lb-btn" data-lb-prev aria-label={t.prev}>←</button>
        <button type="button" class="lb-btn" data-lb-next aria-label={t.next}>→</button>
        <button type="button" class="lb-btn" data-lb-close aria-label={getUI(lang).close}>✕</button>
      </div>
    </div>
  </dialog>
</section>
